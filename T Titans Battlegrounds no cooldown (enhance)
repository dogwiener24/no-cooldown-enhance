local BUFFS = {
    NUM_ROCKS = 8,
    NUM_SHOTS = 60,
    RECHARGE_DOWNTIME = 0,
    CurrentCooldown = 0,
    DEBOUNCE = 0,
    MAX_NUM_HUMANOIDS_HIT = 999,
    PROJECTILE_SPEED = 299,
    CHARGE_DURATION = 3,
    ATTACK_DURATION = 0,
    SHOCKS_PER_SECOND = 0,
    ZONE_LIFETIME = 8,
    ACTIVE_DURATION = 1,
    HEAL_PER_SECOND = 0,
    PAUSE_DURATION = 0,
    SWING_DURATION = 3,
    SLOW_DURATION = 3,
    PUSH_FORCE = 500,
    SHOTS_PER_BURST = 8,
    BLIND_DURATION = 9,
    CLONE_HEALTH_LOST_PER_SECOND = 0.1,
    NUM_SPIKE_WAVES = 13,
    RAGE_DURATION = 20,
    NUM_ATTACKS = 14,
    NUM_TRIPLE_SHOTS = 10,
    NUM_AOE_SHOTS = 3,
    NUM_SCATTER_SHOTS = 31,
    HEAVY_DAMAGE = 30,
    LIGHT_DAMAGE = 15,
    FLIGHT_DURATION = 10,
    NUM_BOMBS = 10,
    TNT_DAMAGE = 35,
    TOXIC_BARREL_TICK_DAMAGE = 20,
    NUM_BURSTS = 10,
    MAX_NUM_PER_ATTACK = 10,
}

local originalValues = {}
local enabled = false

local function applyBuffs()
    if enabled then return end
    enabled = true
    for _, tbl in next, getgc(true) do
        if type(tbl) == "table" then
            for key, value in pairs(BUFFS) do
                if rawget(tbl, key) ~= nil then
                    originalValues[tbl] = originalValues[tbl] or {}
                    if originalValues[tbl][key] == nil then
                        originalValues[tbl][key] = tbl[key]
                    end
                    setreadonly(tbl, false)
                    rawset(tbl, key, value)
                    setreadonly(tbl, true)
                end
            end
        end
    end
end

local function resetBuffs()
    if not enabled then return end
    enabled = false
    for tbl, keys in pairs(originalValues) do
        setreadonly(tbl, false)
        for key, value in pairs(keys) do
            rawset(tbl, key, value)
        end
        setreadonly(tbl, true)
    end
    table.clear(originalValues)
end

